# This repo ships ONLY the self-contained deployed tool + docs.
# Ignore everything by default, then re-include the deploy artifacts.
*
!.gitignore
!/index.html
!/tool.html
!/news.html
!/sitemap.xml
!/robots.txt
!/posts/
!/posts/*.html
!/index_en.html
!/news_en.html
!/posts/2026-07_en.html

!/README.md
!/.nojekyll
!/launches.html
!/launches_en.html

# 英文版生成脚本（ZH→EN 管线；密钥不在此文件内，运行时从 .translate_key 读取）
!/make_en_v2.py

# 翻译 API key（本地受保护，绝不入库）
.translate_key

# 翻译缓存映射（本地状态，重跑可重建；放项目内避免 /tmp 被系统清理）
/.cache/
